{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "unicorn", "oxc", "import"],
    "categories": {
        "correctness": "error"
    },
    "rules": {
        "no-restricted-imports": [
            "error",
            { "patterns": [{ "group": ["./*", "../*"], "message": "用 @/ 绝对路径 import" }] }
        ]
    },
    "env": {
        "builtin": true,
        "browser": true
    },
    "ignorePatterns": ["**/dist/**", "**/.astro/**"]
}
