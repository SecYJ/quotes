---
import type { Quote } from '@/lib/quotes'
import { isoDate, monthDay, sourceName } from '@/lib/labels'

type Props = {
    quote: Quote
    hidden?: boolean
}

const { quote, hidden } = Astro.props
const search = `${quote.content}\n${quote.speaker ?? ''}\n${quote.source.title}`.toLowerCase()
---

<article
    class="quote"
    data-source={quote.source.id}
    data-tags={quote.tags.join('\n')}
    data-search={search}
    hidden={hidden}
>
    <time class="date" datetime={isoDate(quote.added)}>
        <span class="day">{monthDay(quote.added)}</span>
        <span class="year">{quote.added.getUTCFullYear()}</span>
    </time>
    <div class="entry">
        <blockquote class="content" data-highlight>{quote.content}</blockquote>
        <p class="byline">
            {
                quote.speaker && (
                    <>
                        <span class="speaker" data-highlight>
                            {quote.speaker}
                        </span>
                        <span class="sep" aria-hidden="true">
                            ·
                        </span>
                    </>
                )
            }
            <a
                class="source-link"
                href={`?source=${quote.source.id}`}
                data-filter-source={quote.source.id}
                data-highlight>{sourceName(quote.source)}</a
            >
            {quote.detail && <span class="detail">{quote.detail}</span>}
        </p>
        {quote.note && <p class="note">{quote.note}</p>}
        <p class="foot">
            <span class="tags">
                {
                    quote.tags.map((tag) => (
                        <a href={`?tag=${encodeURIComponent(tag)}`} data-filter-tag={tag}>
                            {tag}
                        </a>
                    ))
                }
            </span>
            <button type="button" class="copy" data-copy={quote.content} aria-label="复制这句名句" title="复制">
                <svg class="icon icon-copy" viewBox="0 0 16 16" aria-hidden="true">
                    <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect>
                    <path d="M10.5 5.5V4A1.5 1.5 0 0 0 9 2.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5"></path>
                </svg>
                <svg class="icon icon-done" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M3 8.5l3.2 3.2L13 4.8"></path>
                </svg>
                <svg class="icon icon-failed" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M4 4l8 8M12 4l-8 8"></path>
                </svg>
            </button>
        </p>
    </div>
</article>
