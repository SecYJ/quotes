---
import 'lxgw-wenkai-screen-webfont/lxgwwenkaigbscreen.css'
import '@/styles/global.css'
import QuoteItem from '@/components/QuoteItem.astro'
import { loadQuotes } from '@/lib/quotes'
import { formatDate } from '@/lib/labels'

const quotes = await loadQuotes()

const sourceCount = new Set(quotes.map((q) => q.source.id)).size
const tags = new Map<string, number>()
for (const q of quotes) for (const t of q.tags) tags.set(t, (tags.get(t) ?? 0) + 1)
const tagList = [...tags].toSorted((a, b) => b[1] - a[1])
const updated = quotes[0]?.added

const SIDE = 3
---

<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="dark" />
        <meta name="theme-color" content="#14161a" />
        <meta name="description" content="一个人收集的名句：剧、书、现实生活里听到的句子，每句都记着出处。" />
        <title>拾句 · 夜里的摘抄本</title>
    </head>
    <body>
        <div class="paper">
            <aside class="rail">
                <header class="mast">
                    <h1 class="mast-title">拾句</h1>
                    <p class="mast-sub">夜里的摘抄本</p>
                    <p class="dateline">
                        {quotes.length} 句 · {sourceCount} 个出处<br />
                        {updated && <>最后写下 {formatDate(updated)}</>}
                    </p>
                </header>

                <nav class="index" aria-label="筛选名句">
                    <form class="search" role="search" action="" method="get">
                        <label for="q" class="visually-hidden">搜索句子、说话人或出处</label>
                        <input id="q" name="q" type="search" placeholder="搜索句子、说话人或出处" autocomplete="off" />
                    </form>

                    <details class="index-panel" open>
                        <summary>标签</summary>
                        <div class="index-row">
                            <h2 class="index-label">标签</h2>
                            <ul class="index-list tag-list">
                                <li><a href="?" data-filter-tag="" aria-current="true">全部</a></li>
                                {
                                    tagList.map(([tag, count]) => (
                                        <li>
                                            <a href={`?tag=${encodeURIComponent(tag)}`} data-filter-tag={tag}>
                                                {tag}
                                                <span class="count">{count}</span>
                                            </a>
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>
                    </details>
                </nav>
            </aside>

            <div class="page">
                <p class="status" aria-live="polite" hidden>
                    <span class="status-text"></span>
                    <a href="?" class="clear">清除筛选</a>
                </p>

                <main class="issue">
                    <section class="lead" aria-label="最新">
                        {quotes.slice(0, 1).map((q) => <QuoteItem quote={q} />)}
                    </section>
                    <section class="side" aria-label="接着">
                        {quotes.slice(1, 1 + SIDE).map((q) => <QuoteItem quote={q} />)}
                    </section>
                    <section class="rest" aria-label="更早">
                        {quotes.slice(1 + SIDE).map((q) => <QuoteItem quote={q} />)}
                    </section>
                    <p class="empty" hidden>
                        这本子里没有符合的句子。<a href="?" class="clear">清除筛选</a>
                    </p>
                </main>

                <footer class="colophon">拾句 · 夜里写下的句子</footer>
            </div>
        </div>

        <p class="visually-hidden" aria-live="polite" data-copy-status></p>

        <script>
            import { startCopy } from '@/scripts/copy'
            import { startIssue } from '@/scripts/issue'
            startIssue()
            startCopy()
        </script>
    </body>
</html>
