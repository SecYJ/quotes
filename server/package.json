{
    "name": "server",
    "private": true,
    "type": "module",
    "imports": {
        "#/*": "./src/*.ts"
    },
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "dev": "node -e \"require('node:fs').mkdirSync('../client/dist',{recursive:true})\" && wrangler dev --var ACCESS_DEV_BYPASS:true",
        "deploy": "wrangler deploy",
        "cf-typegen": "wrangler types --strict-vars=false",
        "typecheck": "tsc -b",
        "db:generate": "drizzle-kit generate",
        "db:migrate:local": "wrangler d1 migrations apply lines --local"
    },
    "dependencies": {
        "@hono/zod-validator": "^0.9.1",
        "drizzle-orm": "^0.45.4",
        "hono": "^4.13.13",
        "jose": "^6.2.13",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "drizzle-kit": "^0.31.11",
        "typescript": "^7.0.2",
        "wrangler": "^4.152.0"
    }
}
