{
    "$schema": "../node_modules/wrangler/config-schema.json",
    "name": "lines",
    "main": "./src/index.ts",
    "compatibility_date": "2026-10-25",
    "assets": {
        // client 的 build 输出（vite build → client/dist）
        "directory": "../client/dist",
        // 找不到的静态文件回传 index.html，交给 TanStack Router 处理
        "not_found_handling": "single-page-application",
        // 只有 /api/* 先进 Worker（Hono），其他路径直接由 static assets 处理
        "run_worker_first": ["/api/*"],
    },
    "d1_databases": [
        {
            // Worker 里用 env.DB 拿到数据库，不需要连线字串
            "binding": "DB",
            "database_name": "lines",
            // 本地开发不需要 database_id；阶段 5 建立远端 D1 后再填
            // drizzle-kit generate 产生的 SQL 放这里，由 wrangler d1 migrations apply 套用
            "migrations_dir": "drizzle",
        },
    ],
    "observability": {
        "enabled": true,
    },
}
